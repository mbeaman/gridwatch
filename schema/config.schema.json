{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gridwatch config.toml (§9)",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "theme": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "fps_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "color": {
      "enum": [
        "auto",
        "always",
        "never",
        "16",
        "256",
        "truecolor"
      ]
    },
    "mouse": {
      "type": "boolean"
    },
    "readonly": {
      "type": "boolean"
    },
    "confirm_kill": {
      "type": "boolean"
    },
    "store": {
      "type": "object",
      "properties": {
        "history": {
          "type": "string"
        },
        "max_mb": {
          "type": "integer"
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budget_ms": {
          "type": "integer"
        }
      }
    },
    "perf": {
      "type": "object",
      "properties": {
        "unfocused_fps": {
          "type": "integer"
        },
        "phase_ms": {
          "type": "integer"
        }
      }
    },
    "sources": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "options": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "description": "Alert rules (§9, arc 7b): each turns one metric into an alert with two holds.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "key",
          "op"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The alert's title, and the first half of its id."
          },
          "key": {
            "type": "string",
            "description": "A metric name, optionally with a label glob: sensor.temp_c{nvme*:Composite}."
          },
          "op": {
            "type": "string",
            "enum": [
              ">",
              ">=",
              "<",
              "<=",
              "==",
              "!=",
              "gt",
              "ge",
              "lt",
              "le",
              "eq",
              "ne",
              "absent"
            ]
          },
          "value": {
            "description": "A number, or the name of another metric read at the same label.",
            "type": [
              "number",
              "string"
            ]
          },
          "for_s": {
            "type": "number",
            "minimum": 0,
            "description": "How long the condition must hold before it raises; for `absent`, how long the key may be missing."
          },
          "clear_s": {
            "type": "number",
            "minimum": 0,
            "description": "How long it must stop holding before it resolves (defaults to for_s)."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "crit"
            ]
          },
          "message": {
            "type": "string",
            "description": "{key} {label} {value} {threshold} {op} are substituted."
          }
        },
        "additionalProperties": false
      }
    },
    "record": {
      "type": "object",
      "description": "Recording config — parsed and ignored until arc 2 (§9)."
    }
  },
  "additionalProperties": false
}
