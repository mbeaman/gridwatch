{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gridwatch config.toml (§9)",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "theme": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "fps_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "color": {
      "enum": [
        "auto",
        "always",
        "never",
        "16",
        "256",
        "truecolor"
      ]
    },
    "mouse": {
      "type": "boolean"
    },
    "readonly": {
      "type": "boolean"
    },
    "confirm_kill": {
      "type": "boolean"
    },
    "store": {
      "type": "object",
      "properties": {
        "history": {
          "type": "string"
        },
        "max_mb": {
          "type": "integer"
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "budget_ms": {
          "type": "integer"
        }
      }
    },
    "perf": {
      "type": "object",
      "properties": {
        "unfocused_fps": {
          "type": "integer"
        },
        "phase_ms": {
          "type": "integer"
        }
      }
    },
    "sources": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "options": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "description": "Alert rules (§9, arc 7b): each turns one metric into an alert with two holds.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "key",
          "op"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The alert's title, and the first half of its id."
          },
          "key": {
            "type": "string",
            "description": "A metric name, optionally with a label glob: sensor.temp_c{nvme*:Composite}."
          },
          "op": {
            "type": "string",
            "enum": [
              ">",
              ">=",
              "<",
              "<=",
              "==",
              "!=",
              "gt",
              "ge",
              "lt",
              "le",
              "eq",
              "ne",
              "absent"
            ]
          },
          "value": {
            "description": "A number, or the name of another metric read at the same label.",
            "type": [
              "number",
              "string"
            ]
          },
          "for_s": {
            "type": "number",
            "minimum": 0,
            "description": "How long the condition must hold before it raises; for `absent`, how long the key may be missing."
          },
          "clear_s": {
            "type": "number",
            "minimum": 0,
            "description": "How long it must stop holding before it resolves (defaults to for_s)."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "crit"
            ]
          },
          "message": {
            "type": "string",
            "description": "{key} {label} {value} {threshold} {op} are substituted."
          }
        },
        "additionalProperties": false
      }
    },
    "record": {
      "type": "object",
      "description": "Recording config — parsed and ignored until arc 2 (§9)."
    },
    "plugins": {
      "type": "array",
      "description": "Exec plugins (§4.7, arc 8b): one child process each, started at launch and registered as a placeable kind `<id>.<the kind its manifest declares>`. Restart-only — a hot reload reports the change and does not apply it.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Namespaces the plugin's keys and its kind; must be unique."
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "A program and its arguments, verbatim. Never a shell string."
          },
          "rss_mb": {
            "type": "integer",
            "minimum": 1,
            "description": "RLIMIT_AS for the child, in MiB (default 256)."
          },
          "cpu_secs": {
            "type": "integer",
            "minimum": 1,
            "description": "RLIMIT_CPU for the child, in seconds (default 600)."
          },
          "hello_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "How long the host waits at startup for this plugin's manifest before chipping the tile and going on without it (default 2000). Every plugin is spawned first and they wait together, so N plugins cost the longest one, not the sum."
          },
          "render_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "The floor between two `render` asks for the same unchanged tile (default 1000). A changed tier, size, focus or capture asks at once."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
