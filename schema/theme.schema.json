{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gridwatch theme file (§7; D52: self-contained unless `inherits` names a parent)",
  "type": "object",
  "required": [
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "const": 1
        },
        "variant": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "inherits": {
          "type": "string"
        },
        "class": {
          "enum": [
            "quiet",
            "showcase"
          ]
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "tertiary": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "severity": {
          "type": "object",
          "properties": {
            "ok": {
              "$ref": "#/$defs/color"
            },
            "warn": {
              "$ref": "#/$defs/color"
            },
            "crit": {
              "$ref": "#/$defs/color"
            },
            "info": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "selection": {
          "type": "object",
          "properties": {
            "fg": {
              "$ref": "#/$defs/color"
            },
            "bg": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "bg": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "panel": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "border_focused": {
          "$ref": "#/$defs/color"
        },
        "title": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "text_muted": {
          "$ref": "#/$defs/color"
        },
        "text_ghost": {
          "$ref": "#/$defs/color"
        },
        "cursor": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "gradients": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/color"
        },
        "minItems": 1
      }
    },
    "glyphs": {
      "type": "object",
      "properties": {
        "rain": {
          "enum": [
            "katakana",
            "ascii"
          ]
        }
      }
    },
    "borders": {
      "type": "object"
    },
    "title": {
      "type": "object"
    },
    "widgets": {
      "type": "object"
    },
    "flourish": {
      "type": "object",
      "properties": {
        "grid_floor": {
          "type": "boolean"
        },
        "sun": {
          "type": "boolean"
        },
        "marquee": {
          "type": "boolean"
        },
        "decode": {
          "type": "boolean"
        },
        "big_clock": {
          "type": "object",
          "properties": {
            "pixel": {
              "enum": [
                "quadrant",
                "sextant",
                "full"
              ]
            }
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sweep_in",
                "fade_in",
                "dissolve",
                "fade",
                "hsl_pulse"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "motion": {
              "type": "string"
            },
            "lightness": {
              "type": "number"
            },
            "period_ms": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "theme_swap": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sweep_in",
                "fade_in",
                "dissolve",
                "fade",
                "hsl_pulse"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "motion": {
              "type": "string"
            },
            "lightness": {
              "type": "number"
            },
            "period_ms": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "focus": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sweep_in",
                "fade_in",
                "dissolve",
                "fade",
                "hsl_pulse"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "motion": {
              "type": "string"
            },
            "lightness": {
              "type": "number"
            },
            "period_ms": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "alert": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sweep_in",
                "fade_in",
                "dissolve",
                "fade",
                "hsl_pulse"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            },
            "motion": {
              "type": "string"
            },
            "lightness": {
              "type": "number"
            },
            "period_ms": {
              "type": "integer"
            },
            "target": {
              "type": "string"
            }
          }
        }
      }
    },
    "ambient": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "matrix_rain"
          ]
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "density": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "reveal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reveal_ms": {
          "type": "integer"
        },
        "governor": {
          "type": "boolean"
        },
        "light": {
          "type": "object",
          "properties": {
            "fade_s": {
              "type": "number"
            },
            "trail_ms": {
              "type": "integer"
            },
            "sweep_s": {
              "type": "number"
            },
            "head": {
              "$ref": "#/$defs/color"
            },
            "floor": {
              "$ref": "#/$defs/color"
            },
            "relight_on_update": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "gradients": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/color"
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "contrast": {
      "type": "object",
      "properties": {
        "autofix": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|default|\\$[A-Za-z_][A-Za-z0-9_]*|(bright-)?(black|red|green|yellow|blue|magenta|cyan|white)|ansi:(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9]))$"
    }
  },
  "if": {
    "properties": {
      "meta": {
        "not": {
          "required": [
            "inherits"
          ]
        }
      }
    }
  },
  "then": {
    "required": [
      "meta",
      "colors",
      "gradients"
    ],
    "properties": {
      "colors": {
        "required": [
          "bg",
          "surface",
          "panel",
          "border",
          "border_focused",
          "title",
          "text",
          "text_muted",
          "text_ghost",
          "cursor",
          "accent",
          "severity",
          "selection"
        ],
        "properties": {
          "accent": {
            "required": [
              "primary",
              "secondary",
              "tertiary"
            ]
          },
          "severity": {
            "required": [
              "ok",
              "warn",
              "crit",
              "info"
            ]
          },
          "selection": {
            "required": [
              "fg",
              "bg"
            ]
          }
        }
      },
      "gradients": {
        "required": [
          "load",
          "temp",
          "power",
          "mem",
          "netrx",
          "nettx",
          "audio",
          "title"
        ]
      }
    }
  }
}
