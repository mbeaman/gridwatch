{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gridwatch theme file (§7; D52: self-contained unless `inherits` names a parent)",
  "type": "object",
  "required": [
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "const": 1
        },
        "variant": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "inherits": {
          "type": "string"
        },
        "class": {
          "enum": [
            "quiet",
            "showcase"
          ]
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "object"
        },
        "severity": {
          "type": "object"
        },
        "selection": {
          "type": "object"
        }
      }
    },
    "gradients": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/color"
        },
        "minItems": 1
      }
    },
    "glyphs": {
      "type": "object"
    },
    "borders": {
      "type": "object"
    },
    "title": {
      "type": "object"
    },
    "widgets": {
      "type": "object"
    },
    "flourish": {
      "type": "object"
    },
    "effects": {
      "type": "object"
    },
    "ambient": {
      "type": "object"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "gradients": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/color"
              },
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|default|\\$[A-Za-z_][A-Za-z0-9_]*|(bright-)?(black|red|green|yellow|blue|magenta|cyan|white)|ansi:(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9]))$"
    }
  },
  "if": {
    "properties": {
      "meta": {
        "not": {
          "required": [
            "inherits"
          ]
        }
      }
    }
  },
  "then": {
    "required": [
      "meta",
      "colors",
      "gradients"
    ],
    "properties": {
      "colors": {
        "required": [
          "bg",
          "surface",
          "panel",
          "border",
          "border_focused",
          "title",
          "text",
          "text_muted",
          "text_ghost",
          "cursor",
          "accent",
          "severity",
          "selection"
        ],
        "properties": {
          "accent": {
            "required": [
              "primary",
              "secondary",
              "tertiary"
            ]
          },
          "severity": {
            "required": [
              "ok",
              "warn",
              "crit",
              "info"
            ]
          },
          "selection": {
            "required": [
              "fg",
              "bg"
            ]
          }
        }
      },
      "gradients": {
        "required": [
          "load",
          "temp",
          "power",
          "mem",
          "netrx",
          "nettx",
          "audio",
          "title"
        ]
      }
    }
  }
}
