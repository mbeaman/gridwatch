{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gridwatch plugin manifest (§4.6/§4.7, arc 8b) — what a plugin says it is",
  "description": "The JSON form of the `Manifest` a built-in component declares in Rust. A plugin sends this once, in answer to `hello`; the host refuses to place a tile whose manifest does not validate, and says why.",
  "type": "object",
  "required": ["kind", "name", "contract", "tiers"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "How a layout names this tile. The host namespaces it under the plugin's id, so two plugins may both call themselves `weather`."
    },
    "name": { "type": "string", "maxLength": 40, "description": "The title a person reads." },
    "summary": { "type": "string", "maxLength": 200 },
    "contract": { "type": "integer", "minimum": 1 },
    "footprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["w", "h"],
        "additionalProperties": false,
        "properties": {
          "w": { "type": "integer", "minimum": 1, "maximum": 12 },
          "h": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    },
    "default_footprint": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 12 },
        "h": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "description": "Poorest first and cumulative, exactly as a built-in's are. The first tier's `min` must fit 8x3 — the smallest tile this grid can make — and the host refuses a manifest whose first tier does not.",
      "items": {
        "type": "object",
        "required": ["name", "min"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 24 },
          "min": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          },
          "adds": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
          "zoom_only": { "type": "boolean" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capabilities without which this tile cannot work; the host draws the placeholder and the fix line instead of placing it."
    },
    "optional": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Source ids this tile reads. A plugin that is its own source names itself."
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
          "unit": {
            "enum": [
              "percent", "bytes", "bytes_per_sec", "celsius", "watts", "amps", "volts",
              "megahertz", "megabits_per_sec", "count", "seconds", "milliseconds", "ratio", "none"
            ]
          },
          "help": { "type": "string", "maxLength": 200 }
        }
      },
      "description": "The metrics this plugin publishes, so `gridwatch keys` can list them beside the built-in ones."
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "does"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "maxLength": 12 },
          "does": { "type": "string", "maxLength": 60 }
        }
      },
      "description": "What the key bar shows once the tile is captured."
    },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Instance option names this plugin accepts, so a typo in a layout is a warning rather than silence."
    }
  }
}
